<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network policy.

  Android blocks cleartext HTTP by default (targetSdk 28+), which would stop
  the dev flavor from reaching http://192.168.1.12:5001. Cleartext is opened
  here for the local dev hosts ONLY, and because this file lives in the debug
  source set it is never merged into a release build.

  Add further LAN addresses here as needed; do not switch to a blanket
  cleartextTrafficPermitted="true" on the base config.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- LAN dev server (AppFlavor.dev baseUrl) -->
        <domain includeSubdomains="false">192.168.1.12</domain>
        <!-- Host machine as seen from the Android emulator -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
